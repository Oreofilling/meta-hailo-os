[Unit]
Description=Install service units from persistent storage
Requires=camthink-system-ready.target
After=camthink-system-ready.target
RequiresMountsFor=/data
Before=multi-user.target
ConditionPathExists=/data/aipc/systemd/

[Service]
Type=oneshot
ExecStart=/usr/libexec/aipc-app-bootstrap
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=aipc-app-bootstrap
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
